class AgentRetriever:
    """One flat query plan and a shared, deduplicated page store."""

    def __init__(self, hybrid, llm, documents):
        self.hybrid = hybrid
        self.llm = llm
        self.pages = {(d.metadata["source"], d.metadata["page"]): d for d in documents}
        self.available_pages = {}
        for source, page in self.pages:
            self.available_pages.setdefault(source, []).append(page)
        for pages in self.available_pages.values():
            pages.sort()
        self.reset_trace()

    def reset_trace(self):
        self.last_searches, self.last_actions = [], []
        self.evidence, self.paper_store, self.page_aliases = {}, {}, {}
        self.content_ids, self.notes = {}, {}
        self.fresh, self.read_ids, self.queries = [], set(), set()
        self.read_order, self.search_groups = [], []
        self.actions_used = self.planner_calls_used = 0
        self.planner_call_limit = MAX_PLANNER_CALLS
        self.stop_reason = ""
        self.final_page_ids = []
        self.retrieval_plan = {}
        self.status = "pending"
        self.missing_evidence = []
        self.stalled_attempts = 0
        self.routing_done = False
        self.validation_feedback = None

    @staticmethod
    def query_key(query):
        return " ".join(re.findall(r"\w+", query.casefold()))

    @staticmethod
    def parse_plan(raw):
        """Accept one object, or identical repeated objects; never choose between conflicting plans."""
        if not isinstance(raw, str):
            raise ValueError("Plan must be JSON text")
        if raw.strip().startswith("```"):
            raw = "\n".join(raw.strip().splitlines()[1:-1])
        decoder = json.JSONDecoder()
        objects = []
        remaining = raw.strip()
        while remaining:
            value, position = decoder.raw_decode(remaining)
            if not isinstance(value, dict):
                raise ValueError("Plan must be an object")
            objects.append(value)
            remaining = remaining[position:].strip()
        if not objects or any(value != objects[0] for value in objects):
            raise ValueError("Ambiguous or empty plan")
        return objects[0]

    def add_page(self, doc, score):
        page_id = doc.metadata["id"]
        # Collapse exact text copies, not fuzzy title matches or different editions.
        fingerprint = hashlib.sha256(doc.page_content.strip().encode()).hexdigest()
        canonical = self.content_ids.get(fingerprint, page_id) if doc.page_content.strip() else page_id
        self.page_aliases[page_id] = canonical
        paper_id = doc.metadata["source"]  # Stable corpus file ID; titles are not reliable IDs.
        paper = self.paper_store.setdefault(paper_id, {"title": doc.metadata.get("title", ""),
                                                     "page_ids": []})
        if canonical not in paper["page_ids"]:
            paper["page_ids"].append(canonical)
        if canonical not in self.evidence:
            self.content_ids[fingerprint] = canonical
            self.evidence[canonical] = (doc, score)
            self.fresh.append({**page_record(doc, score),
                               "text": doc.page_content[:EVIDENCE_CHARACTERS],
                               "truncated": len(doc.page_content) > EVIDENCE_CHARACTERS})
        return canonical

    def payload(self, question, k):
        catalog = [{**page_record(doc, score), "excerpt": doc.page_content[:240],
                    "note": self.notes.get(page_id, "")}
                   for page_id, (doc, score) in self.evidence.items()]
        return {
            "original_question": question, "retrieval_plan": self.retrieval_plan,
            "initial_routing": not self.routing_done,
            "validation_feedback": self.validation_feedback,
            "planner_calls_remaining": self.planner_call_limit - self.planner_calls_used,
            "actions_remaining": MAX_TOOL_ACTIONS - self.actions_used,
            "capabilities": {
                "search": "Hybrid BM25/semantic corpus search; returns IDs, titles and snippets. No web search.",
                "read_page": "Full saved text of a discovered file's physical PDF page, once. No OCR/image interpretation.",
                "finish": "Choose supporting IDs and disclose gaps. Final answer is generated separately.",
                "shared_evidence": "Deduplicated pages retained locally by ID; reuse references without rereading.",
            },
            "resource_limits": {
                "total_llm_call_cap": MAX_LLM_CALLS,
                "reserved_answer_calls": 1,
                # A context-sized ceiling leaves room for follow-up reading, not a query quota.
                "max_initial_searches": min(k, MAX_TOOL_ACTIONS - 1),
                "final_context_pages": k,
            },
            "context_limit": k, "evidence": catalog, "fresh_evidence": self.fresh,
            "papers": self.paper_store,
            "available_pages": {s: self.available_pages[s] for s in self.paper_store},
            "previous_queries": sorted(self.queries), "already_read_ids": sorted(self.read_ids),
        }

    def search(self, query, reason, k):
        hits = self.hybrid.retrieve(query, k)
        ids = list(dict.fromkeys(self.add_page(doc, score) for doc, score in hits))
        self.search_groups.append(ids)
        self.queries.add(self.query_key(query))
        self.actions_used += 1
        self.last_searches.append({"hop": len(self.last_searches) + 1, "query": query,
                                  "candidates": [page_record(doc, score) for doc, score in hits]})
        self.last_actions.append({"action": "search", "query": query,
                                  "reason": reason, "returned_ids": ids})

    def read_page(self, source, page, reason):
        page_id = self.add_page(self.pages[(source, page)], None)
        self.fresh = [item for item in self.fresh if item["id"] != page_id]
        stored, score = self.evidence[page_id]
        self.fresh.append({**page_record(stored, score), "text": stored.page_content,
                           "truncated": False})
        self.read_ids.add(page_id)
        self.read_order.append(page_id)
        self.actions_used += 1
        self.last_actions.append({"action": "read_page", "source": source, "page": page,
                                  "page_id": page_id, "reason": reason,
                                  "characters": len(stored.page_content)})

    def route(self, plan, question, k):
        if plan.get("choice") not in {"direct", "decompose"}:
            raise ValueError("invalid_route")
        # Validate the entire plan before running any searches.
        if any(key in plan for key in ("children", "depth", "parent_id", "call_budget")):
            raise ValueError("invalid_route")
        if plan["choice"] == "direct":
            if plan.get("subquestions"):
                raise ValueError("invalid_route")
            questions = [{"topic": "Original question", "question": question,
                          "required_evidence": [question]}]
        else:
            questions = plan.get("subquestions")
            limit = min(k, MAX_TOOL_ACTIONS - 1)
            if not isinstance(questions, list) or not 2 <= len(questions) <= limit:
                raise ValueError("invalid_subquestions")
            seen_questions, seen_topics = set(), set()
            for item in questions:
                if not isinstance(item, dict) or set(item) != {
                        "topic", "question", "required_evidence", "why_separate"}:
                    raise ValueError("invalid_subquestion")
                for field in ("topic", "question", "why_separate"):
                    if (not isinstance(item[field], str) or not self.query_key(item[field])
                            or len(item[field]) > 2000):
                        raise ValueError("invalid_subquestion")
                requirements = item["required_evidence"]
                if (not isinstance(requirements, list) or not 1 <= len(requirements) <= 8
                        or any(not isinstance(r, str) or not r.strip() or len(r) > 500
                               for r in requirements)):
                    raise ValueError("invalid_subquestion")
                query_key, topic_key = self.query_key(item["question"]), self.query_key(item["topic"])
                if query_key in seen_questions or topic_key in seen_topics:
                    raise ValueError("invalid_duplicate_subquestion")
                seen_questions.add(query_key)
                seen_topics.add(topic_key)
        self.retrieval_plan = {"choice": plan["choice"], "reason": plan["reason"],
                               "subquestions": questions}
        self.routing_done = True
        self.last_actions.append({"action": "route", **self.retrieval_plan})
        # Search each evidence need once before the shared follow-up loop.
        for item in questions:
            self.search(item["question"], "Initial planned search: " + item["topic"], k)

    def execute(self, plan, question, k):
        action, reason = plan.get("action"), plan.get("reason")
        if not isinstance(reason, str) or not reason.strip():
            raise ValueError("invalid_plan")
        if not self.routing_done:
            if action != "route":
                raise ValueError("invalid_route")
            self.route(plan, question, k)
            return True
        for note in plan.get("evidence_notes", []) if isinstance(plan.get("evidence_notes", []), list) else []:
            if isinstance(note, dict) and isinstance(note.get("page_id"), str):
                page_id = self.page_aliases.get(note["page_id"], note["page_id"])
                if page_id in self.evidence and isinstance(note.get("note"), str):
                    self.notes[page_id] = note["note"][:EVIDENCE_NOTE_CHARACTERS]
        if action == "finish":
            ids = plan.get("page_ids")
            status = plan.get("status", "sufficient" if ids else "insufficient_evidence")
            missing = plan.get("missing_evidence", [])
            if (not isinstance(ids, list) or len(ids) > k
                    or any(not isinstance(i, str) or self.page_aliases.get(i, i) not in self.evidence for i in ids)):
                raise ValueError("invalid_selection")
            if (status not in {"sufficient", "insufficient_evidence"}
                    or (status == "sufficient" and not ids)
                    or not isinstance(missing, list)
                    or any(not isinstance(item, str) for item in missing)
                    or (status == "sufficient" and missing)):
                raise ValueError("invalid_completion")
            self.final_page_ids = list(dict.fromkeys(self.page_aliases.get(i, i) for i in ids))
            self.status, self.missing_evidence = status, missing[:8]
        elif action not in {"search", "read_page"}:
            raise ValueError("invalid_action")
        elif self.actions_used >= MAX_TOOL_ACTIONS:
            raise ValueError("budget_exhausted")
        elif action == "search":
            query = plan.get("query")
            if not isinstance(query, str) or not self.query_key(query):
                raise ValueError("invalid_query")
            if self.query_key(query) in self.queries:
                raise ValueError("repeated_query")
            self.search(query, reason, k)
        else:
            source, page = plan.get("source"), plan.get("page")
            if (not isinstance(source, str) or source not in self.paper_store
                    or type(page) is not int or (source, page) not in self.pages):
                raise ValueError("invalid_page")
            page_id = self.pages[(source, page)].metadata["id"]
            page_id = self.page_aliases.get(page_id, page_id)
            if page_id in self.read_ids:
                self.validation_feedback = {"code": "cached_page", "page_id": page_id,
                    "message": "Already read. Reuse its ID/note; the final answer receives its full text if selected."}
                self.last_actions.append({"action": "cache_hit", "page_id": page_id})
                return False
            self.read_page(source, page, reason)
        return True

    def fallback_ids(self, k):
        # Preserve opened pages, then alternate search result lists to retain coverage.
        selected = list(self.read_order[:k])
        for offset in range(k):
            for ids in self.search_groups:
                if offset < len(ids) and ids[offset] not in selected and len(selected) < k:
                    selected.append(ids[offset])
        return selected

    def retrieve(self, query, k=TOP_K):
        self.reset_trace()
        remaining = self.llm.remaining if isinstance(self.llm, CountedLLM) else MAX_LLM_CALLS
        self.planner_call_limit = max(0, min(MAX_PLANNER_CALLS, remaining - 1))
        if k <= 0:
            self.stop_reason = "empty_context_limit"
            return []
        k = min(k, TOP_K)
        for _ in range(self.planner_call_limit):
            response = self.llm.invoke([
                SystemMessage(content=ROUTER_SYSTEM if not self.routing_done else AGENT_SYSTEM),
                HumanMessage(content=json.dumps(self.payload(query, k), ensure_ascii=False)),
            ])
            self.planner_calls_used += 1
            self.fresh = []
            self.validation_feedback = None
            error = None
            try:
                plan = self.parse_plan(response.content)
                progressed = self.execute(plan, query, k)
            except (TypeError, ValueError) as exc:
                error = str(exc) if str(exc).startswith(("invalid_", "repeated_", "budget_")) else "invalid_plan"
                progressed = False
                self.validation_feedback = {"code": error,
                    "message": "Return one valid action object only. During routing use direct or independent subquestions; afterwards use search, read_page or finish with known IDs."}
            self.stalled_attempts = 0 if progressed else self.stalled_attempts + 1
            self.last_actions.append({"action": "plan", "response": response.content,
                                      "validation_error": error})
            if error == "budget_exhausted" or self.stalled_attempts >= MAX_STALLED_ATTEMPTS:
                self.stop_reason = error or "repeated_read"
                break
            if self.status != "pending":
                self.stop_reason = "agent_finished" if self.status == "sufficient" else "incomplete_evidence"
                break
        if self.status == "pending":
            self.stop_reason = self.stop_reason or "budget_exhausted"
            self.status = "insufficient_evidence"
            self.missing_evidence = ["Retrieval stopped before completing the evidence check: " + self.stop_reason]
            self.final_page_ids = self.fallback_ids(k)
        # Group full selected pages by source; no duplicate bodies in final context.
        self.final_page_ids.sort(key=lambda i: (self.evidence[i][0].metadata["source"],
                                                self.evidence[i][0].metadata["page"]))
        return [self.evidence[i] for i in self.final_page_ids]


def answer_with_retrieval(llm, query, hits, retriever):
    """Workflow warnings never replace the actual cited source pages."""
    if isinstance(retriever, AgentRetriever):
        coverage = {"status": retriever.status, "missing_evidence": retriever.missing_evidence}
        query += ("\n\nWorkflow coverage (not source evidence):\n" + json.dumps(coverage)
                  + "\nDisclose unresolved gaps. A sufficient status is not proof of correctness: "
                  "ground every claim in the supplied pages only.")
    return answer(llm, query, hits)


class CountedLLM:
    """Enforce a shared per-question budget while retaining cumulative log counts."""

    def __init__(self, llm):
        self.llm = llm
        self.calls = 0
        self.begin_question()

    def begin_question(self):
        self.call_limit = self.calls + MAX_LLM_CALLS

    @property
    def remaining(self):
        return max(0, self.call_limit - self.calls)

    def invoke(self, messages):
        if self.remaining == 0:
            raise RuntimeError("The 15-call LLM budget for this question is exhausted")
        self.calls += 1
        return self.llm.invoke(messages)


def save_chat_session(turns: list[dict]) -> Path:
    """Save the entire session in one file, keeping every turn in order."""
    folder = DATA_DIR / "conversations"
    folder.mkdir(parents=True, exist_ok=True)
    numbers = []
    for path in folder.glob("convo_*.md"):
        match = re.fullmatch(r"convo_(\d+)\.md", path.name)
        if match:
            numbers.append(int(match.group(1)))
    number = max(numbers, default=0) + 1
    while True:
        path = folder / f"convo_{number}.md"
        try:
            # Exclusive creation prevents overwriting another session's export.
            with path.open("x", encoding="utf-8") as file:
                file.write(
                    f"# Conversation {number}\n\n"
                    f"Saved: {datetime.now().astimezone().isoformat(timespec='seconds')}\n\n"
                )
                for turn_number, turn in enumerate(turns, 1):
                    response = turn["response"]
                    if response is None:
                        response = "*No answer completed before the session ended.*"
                    file.write(
                        f"## Question {turn_number}\n\n{turn['question']}\n\n"
                        f"## Answer {turn_number}\n\n{response}\n\n"
                    )
            return path
        except FileExistsError:
            number += 1


def run_chat(build_index: bool = False, check_pdfs: bool = False) -> None:
    """Load the papers once, then answer typed questions without the judge."""
    check_api_key()
    documents, vector_db = load_research_data(build_index, check_pdfs)
    hybrid = HybridRetriever(documents, vector_db)
    llm = CountedLLM(make_llm())
    retriever = AgentRetriever(hybrid, llm, documents)
    print("\nAsk a research-paper question. Type exit or quit to stop.")
    print("Each question is independent; previous messages are not included.")
    print("Questions and retrieved text are sent to OpenRouter. No judge or evaluation logs.\n")
    print(f"The whole session will be saved to {DATA_DIR / 'conversations'} when you exit.\n")
    turns = []  # Export history only; this does not change the LLM's context.

    try:
        while True:
            question = input("You: ").strip()
            if question.lower() in {"exit", "quit"}:
                break
            if not question:
                continue
            turn = {"question": question, "response": None}
            turns.append(turn)
            llm.begin_question()
            # Use the same retrieval and citation prompt, but skip evaluation entirely.
            hits = retriever.retrieve(question, TOP_K)
            response = answer_with_retrieval(llm, question, hits, retriever) if hits else (
                "I do not have supporting evidence in the retrieved pages to answer this question."
            )
            turn["response"] = response
            print(f"\nAssistant: {response}\n")
    except (EOFError, KeyboardInterrupt):
        print("\nChat closed.")
    finally:
        # Save once on exit, interruption, or an error; skip sessions with no questions.
        if turns:
            try:
                saved_path = save_chat_session(turns)
                print(f"Saved: {saved_path}\n")
            except OSError as exc:
                print(f"Warning: could not save this session: {exc}\n")


# %% ENTRY POINT — importing this file does not start chat or call APIs.
def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--build-index", action="store_true",
                        help="Allow creating a missing index; sends PDF text to OpenRouter.")
    parser.add_argument("--check-pdfs", action="store_true",
                        help="Reread PDFs locally to check the saved index for changes.")
    args = parser.parse_args()
    run_chat(args.build_index, args.check_pdfs)


if __name__ == "__main__":
    main()
