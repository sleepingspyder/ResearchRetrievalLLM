                "evidence and must not invent a benchmark result."
            ),
        },
    ]


def validate_framework(llm: ChatOpenAI, retriever: HybridRetriever) -> None:
    """Confirm that the judge rejects a deliberately incorrect answer."""
    item = my_eval_set()[0]
    hits = retriever.retrieve(item["question"], TOP_K)
    good_answer = answer(llm, item["question"], hits)
    manipulated_answer = (
        "The paper used only the MNIST dataset and did not evaluate explainability."
    )
    good_verdict = judge(llm, good_answer, item["grading_notes"])
    manipulated_verdict = judge(llm, manipulated_answer, item["grading_notes"])

    print("\n--- Framework validation ---")
    print(f"  generated answer   -> {good_verdict.upper()}")
    print(f"  manipulated answer -> {manipulated_verdict.upper()}   (expected FAIL)")
    log(
        "FRAMEWORK VALIDATION",
        f"good={good_verdict}\nmanipulated={manipulated_verdict}",
    )


def run_evaluation(retriever: HybridRetriever, llm: ChatOpenAI) -> None:
    eval_set = my_eval_set()
    passes = 0

    print(f"Checkpoint 3.1 — baseline evaluation  |  scenario: {SCENARIO}\n")
    for i, item in enumerate(eval_set, 1):
        hits = retriever.retrieve(item["question"], TOP_K)
        result = answer(llm, item["question"], hits) if hits else "(no pages retrieved)"
        verdict = judge(llm, result, item["grading_notes"])
        passes += verdict == "pass"

        print("=" * 72)
        print(f"Q{i}: {item['question']}")
        for document, score in hits:
            print(f"    - {source_label(document)} | hybrid score={score:.3f}")
        print(f"  verdict: {verdict.upper()}")
        print(f"  answer: {result}\n")

        retrieved = "\n".join(
            f"- {source_label(document)} | hybrid score={score:.3f}"
            for document, score in hits
        )
        log(
            f"Q{i}: {item['question']}",
            f"retrieved:\n{retrieved}\nverdict={verdict}\nanswer={result}",
        )

    print("=" * 72)
    print(f"Baseline pass rate: {passes}/{len(eval_set)}")
    validate_framework(llm, retriever)


def run_chat(retriever, llm) -> None:
    """Search and answer each question independently; no evaluation judge."""
    print("\nAsk about your papers. Type exit or quit to stop.")
    print("Questions and retrieved text are sent to OpenRouter.")
    print("Previous turns are not sent to the model.")
    try:
        while True:
            question = input("\nYou: ").strip()
            if question.lower() in {"exit", "quit"}:
                break
            if not question:
                continue
            hits = retriever.retrieve(question, TOP_K)
            for document, score in hits:
                print(f"  [{source_label(document)}] score={score:.3f}")
            result = answer(llm, question, hits) if hits else "No supporting pages were retrieved."
            print(f"\nAssistant: {result}")
    except (EOFError, KeyboardInterrupt):
        print("\nChat closed.")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--build-index", action="store_true",
                        help="Allow creating a missing index; sends PDF text to OpenRouter.")
    parser.add_argument("--evaluate", action="store_true",
                        help="Run this checkpoint's five questions and judge validation instead of chat.")
    args = parser.parse_args()
    documents, vector_db = load_research_data(args.build_index)
    retriever = HybridRetriever(documents, vector_db)
    llm = make_llm()
    if args.evaluate:
        run_evaluation(retriever, llm)
    else:
        run_chat(retriever, llm)


if __name__ == "__main__":
    main()
